{
	"name": "jest-audio-reporter",
	"version": "3.0.0",
	"description": "Plays audio on jest events",
	"keywords": [
		"jest",
		"reporters",
		"sounds"
	],
	"homepage": "https://github.com/repobuddy/jest-audio-reporter",
	"bugs": {
		"url": "https://github.com/repobuddy/jest-audio-reporter/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/repobuddy/jest-audio-reporter.git"
	},
	"license": "MIT",
	"type": "module",
	"exports": {
		".": {
			"types": "./esm/index.d.ts",
			"default": "./esm/index.js"
		}
	},
	"main": "esm/index.js",
	"typings": "esm/index.d.ts",
	"files": [
		"esm",
		"ts",
		"!ts/**/*.spec.ts"
	],
	"scripts": {
		"build": "tsc -p tsconfig.base.json",
		"clean": "rimraf cjs esm coverage dist",
		"coverage": "jest --coverage",
		"cs": "changeset",
		"depcheck": "depcheck",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"prepare": "husky",
		"release": "changeset publish",
		"test": "jest",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"verify": "run-p lint verify:pkg",
		"verify:pkg": "run-s clean build && run-p depcheck typecheck coverage",
		"version": "changeset version",
		"watch": "jest --watch"
	},
	"dependencies": {
		"@jest/reporters": "^29.0.0 || ^30.0.0",
		"@jest/test-result": "^29.0.0 || ^30.0.0",
		"@jest/types": "^29.0.0 || ^30.0.0",
		"play-sound": "^1.1.6",
		"rc": "^1.2.8"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@changesets/cli": "^3.0.0",
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@repobuddy/biome": "^2.3.1",
		"@types/jest": "^30.0.0",
		"@types/node": "^26.2.0",
		"assertron": "^11.5.4",
		"depcheck": "^1.4.7",
		"husky": "^9.1.7",
		"jest": "^30.0.0",
		"npm-run-all2": "^9.0.3",
		"rimraf": "^6.1.3",
		"ts-jest": "^29.4.12",
		"typescript": "^5.9.0"
	},
	"packageManager": "pnpm@12.4.1",
	"engines": {
		"node": "^20.19.0 || ^22.13.0 || >=24"
	}
}
